---
import { site } from '../data/site';
---
<!-- Cierre -->
<section class="sec closing" aria-labelledby="close-t">
  <div class="wrap">
    <h2 class="script big rv" id="close-t">Nuestro para siempre comienza en…</h2>
    <div class="count rv" style="--d:.08s" aria-live="off">
      <div class="unit arch"><b id="cd-d">0</b><small>Días</small></div>
      <div class="unit arch"><b id="cd-h">0</b><small>Horas</small></div>
      <div class="unit arch"><b id="cd-m">0</b><small>Minutos</small></div>
      <div class="unit arch"><b id="cd-s">0</b><small>Segundos</small></div>
    </div>
    <div class="heart rv" style="--d:.14s"><img src="/img/corazon.webp" alt="" width="560" height="567" loading="lazy"><p>¡Con amor,<br>{site.couple.a} y {site.couple.b}!</p></div>
  </div>
</section>
