---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props { label: string; class?: string; style?: string }
const { label, class: cls, style } = Astro.props;
---
<div class:list={['alias', cls]} style={style}><span style="display:flex;flex-direction:column;align-items:flex-start;line-height:1.3"><small>{label}</small><b>{site.alias}</b></span><button class="copy" type="button" data-copy={site.alias}><Icon name="copy" /><span>Copiar</span></button></div>
